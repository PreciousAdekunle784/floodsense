# Copy to .env (or set in your host's environment). Nothing here is required for a local demo.

# HTTP
PORT=8080
HOST=0.0.0.0
# Set to 1 behind a reverse proxy / PaaS so client IPs (used only as salted hashes for rate limits) are correct
TRUST_PROXY=0
# Secure cookies need HTTPS. Defaults to on when NODE_ENV=production.
NODE_ENV=development
# COOKIE_SECURE=1

# Storage (SQLite database, uploaded photos, server secret). Use a persistent volume in production.
FLOODSENSE_DATA_DIR=./data
# Optional fixed secret (otherwise generated once into $FLOODSENSE_DATA_DIR/.secret). Never commit a real value.
# FLOODSENSE_SECRET=

# First administrator, used only by `npm run setup` when no users exist.
FLOODSENSE_ADMIN_EMAIL=admin@floodsense.local
FLOODSENSE_ADMIN_NAME=FloodSense Admin
# Leave empty to have a strong random password generated and printed once.
FLOODSENSE_ADMIN_PASSWORD=

# Safeguards
REPORTS_PER_HOUR=5
REPORTS_PER_DAY=20
CONTACT_RETENTION_DAYS=30
