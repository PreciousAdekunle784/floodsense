{
  "name": "floodsense",
  "version": "0.1.0",
  "private": true,
  "description": "FloodSense \u2014 GIS flood intelligence and community preparedness prototype for Ogun State, Nigeria",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "setup": "node --env-file-if-exists=.env server/setup.js",
    "demo:reset": "node --env-file-if-exists=.env server/setup.js --reset-demo",
    "test": "node --test server/test/core.test.js",
    "e2e": "node tests/e2e.mjs",
    "setup:turso": "node --env-file=.env.turso server/setup.js",
    "demo:reset:turso": "node --env-file=.env.turso server/setup.js --reset-demo",
    "vercel:sim": "node --env-file-if-exists=.env.vercel-sim scripts/vercel-sim.mjs",
    "e2e:vercel": "E2E_SERVER=scripts/vercel-sim.mjs node tests/e2e.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "express": "^5.3.0",
    "maplibre-gl": "^5.24.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
