{
  "name": "floodsense",
  "version": "0.1.0",
  "private": true,
  "description": "FloodSense — GIS flood intelligence and community preparedness prototype for Ogun State, Nigeria",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "setup": "node --disable-warning=ExperimentalWarning server/setup.js",
    "demo:reset": "node --disable-warning=ExperimentalWarning server/setup.js --reset-demo",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/",
    "e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "express": "^5.3.0",
    "maplibre-gl": "^5.24.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
