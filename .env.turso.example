# Copy to .env.turso and fill in, then run:  npm run setup:turso
# Used only from your computer to create the schema, first admin and demo data in Turso.
# Keep it separate from .env so `npm start` (offline laptop demo) keeps using the local database.
TURSO_DATABASE_URL=libsql://floodsense-<your-org>.turso.io
TURSO_AUTH_TOKEN=
FLOODSENSE_ADMIN_EMAIL=admin@floodsense.local
FLOODSENSE_ADMIN_NAME=FloodSense Admin
# Leave empty to have a strong password generated and printed once.
FLOODSENSE_ADMIN_PASSWORD=
